# LanceAuto: copie para `.env` (cp .env.example .env) e ajuste.
# O .env nunca vai para o git. Os valores abaixo funcionam com `docker compose up` e com o Postgres do Compose.

# --- Banco (PostgreSQL) ---
# Local/Compose: as duas URLs são iguais. O Postgres do Compose fica na porta 5433 do host
# (a 5432 costuma estar ocupada por outro Postgres local).
# No Neon: DATABASE_URL = conexão POOLED (host com "-pooler") terminando em ?pgbouncer=true&connect_timeout=15
#          DIRECT_URL   = conexão DIRETA (sem "-pooler"), usada pelo `prisma migrate deploy`.
DATABASE_URL=postgresql://lanceauto:lanceauto@localhost:5433/lanceauto
DIRECT_URL=postgresql://lanceauto:lanceauto@localhost:5433/lanceauto
# Banco só dos testes de integração da API (o Compose cria os dois bancos).
DATABASE_URL_TEST=postgresql://lanceauto:lanceauto@localhost:5433/lanceauto_test

# --- Segredos (valores de DEV; em produção gere outros: openssl rand -hex 32) ---
JWT_SECRET=dev-jwt-secret-troque-em-producao-0123456789abcdef
AUDIT_HMAC_KEY=dev-audit-hmac-key-troque-em-producao-0123456789abcdef

# --- API ---
PORT=4000
# Origem do web, para CORS e Socket.IO (sem barra no final).
WEB_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT_MAX=30
# 1 desliga todos os rate limits (usado nos testes).
RATE_LIMIT_DISABLED=0

# --- APIs externas (só /catalog/* e criação de lote usam; a S02 confirma os formatos) ---
FIPE_BASE_URL=https://fipe.parallelum.com.br/api/v2
# Opcional: token da FIPE, se houver.
FIPE_TOKEN=
WIKI_USER_AGENT="LanceAuto/0.1 (teste tecnico Verzel; https://github.com/Castelhano30/eliteDevLeilao)"
# Em testes de resiliência, aponte para um endereço que não responde para simular a Wikipedia fora do ar.
WIKIPEDIA_BASE_URL=https://pt.wikipedia.org

# --- Web ---
# Endereço da API visto pelo NAVEGADOR (não pelo container). Embutido no build do Next.
NEXT_PUBLIC_API_URL=http://localhost:4000
